{
  "entities": {
    "mapProject": {
      "title": "Map Project",
      "description": "A saved map workspace containing spatial items, markers, lines, and polygons",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the map project"
        },
        "name": {
          "type": "string",
          "description": "Name of the map project",
          "maxLength": 128
        },
        "shortCode": {
          "type": "string",
          "description": "Alphanumeric short code identifier",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "Detailed mission or project notes",
          "maxLength": 2048
        },
        "group": {
          "type": "string",
          "description": "Access group category (Admins, Registered, Anonymous, None)",
          "maxLength": 64
        },
        "visibility": {
          "type": "string",
          "description": "Sharing visibility mode",
          "enum": ["private", "public", "group"]
        },
        "mapStyle": {
          "type": "string",
          "description": "Preferred basemap visual preset",
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 128
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID or local session ID",
          "maxLength": 128
        },
        "itemsCount": {
          "type": "number",
          "description": "Total number of spatial items in project"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of last modification"
        }
      },
      "required": ["id", "name", "author", "createdAt"]
    },
    "mapItem": {
      "title": "Map Spatial Item",
      "description": "A spatial entity (point, polyline, polygon) within a map project",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the spatial item"
        },
        "mapId": {
          "type": "string",
          "description": "Parent map project identifier"
        },
        "name": {
          "type": "string",
          "description": "Item label or title",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Geometry type",
          "enum": ["marker", "polyline", "polygon"]
        },
        "description": {
          "type": "string",
          "description": "Formatted notes or description",
          "maxLength": 4096
        },
        "icon": {
          "type": "string",
          "description": "Selected icon glyph name or symbol",
          "maxLength": 64
        },
        "color": {
          "type": "string",
          "description": "Primary hex or rgba stroke color",
          "maxLength": 32
        },
        "fillColor": {
          "type": "string",
          "description": "Hex or rgba fill color for polygons",
          "maxLength": 32
        },
        "fillOpacity": {
          "type": "number",
          "description": "Fill opacity between 0 and 1"
        },
        "imageUrl": {
          "type": "string",
          "description": "Image attachment URL or data URL",
          "maxLength": 65536
        },
        "author": {
          "type": "string",
          "description": "Author display name",
          "maxLength": 128
        },
        "authorUid": {
          "type": "string",
          "description": "Author UID",
          "maxLength": 128
        },
        "coordinates": {
          "type": "string",
          "description": "JSON serialized coordinates array",
          "maxLength": 32768
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 update timestamp"
        }
      },
      "required": ["id", "mapId", "name", "type", "createdAt"]
    }
  },
  "firestore": {
    "/maps/{mapId}": {
      "schema": "mapProject",
      "description": "Map project collections containing workspace metadata and sharing rules"
    },
    "/maps/{mapId}/items/{itemId}": {
      "schema": "mapItem",
      "description": "Spatial items (points of interest, paths, and polygons) belonging to a map project"
    }
  }
}
